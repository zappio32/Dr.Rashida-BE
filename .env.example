# ── Application ────────────────────────────────
# URL where the Next.js frontend runs (used for CORS + cookies)
APP_URL=http://localhost:3000

# ── Auth / Security ────────────────────────────
# Must be at least 32 random characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=jhfuh83832jbshwqdg83yt73hdo3y879uih893y8/32/23

# ── Clinic Settings ────────────────────────────
CLINIC_TIMEZONE=Asia/Kolkata

# ── CORS ───────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash, no wildcards)
CORS_ORIGINS=http://localhost:3000

# Cookie domain (leave blank for localhost)
COOKIE_DOMAIN=

# ── Demo / Feature Flags ───────────────────────
# Set to false to enable real payment flow
DEMO_MODE=true
PAYMENT_REQUIRED=false
PAYMENT_PROVIDER=configured-provider
