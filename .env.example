DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
APP_URL=https://your-frontend-domain.example.com
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters
NODE_ENV=production
DEMO_MODE=true
CLINIC_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.example.com
COOKIE_DOMAIN=
PAYMENT_REQUIRED=false
PAYMENT_PROVIDER=configured-provider
PAYMENT_WEBHOOK_SECRET=replace-with-a-webhook-signing-secret
